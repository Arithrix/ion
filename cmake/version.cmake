# Run at build time (cmake -P). Writes ion_version.h only when its content changes,
# so an unchanged tree doesn't trigger rebuilds.
#   -DION_VERSION=0.0.1 -DION_SOURCE_DIR=... -DION_OUTPUT=.../ion_version.h

set(commit "unknown")
set(dirty 0)
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD
                  WORKING_DIRECTORY ${ION_SOURCE_DIR}
                  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE rc ERROR_QUIET)
  if(NOT rc EQUAL 0)
    set(commit "unknown")
  endif()
  execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain
                  WORKING_DIRECTORY ${ION_SOURCE_DIR}
                  OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT status STREQUAL "")
    set(dirty 1)
  endif()
endif()

string(TIMESTAMP date "%Y-%m-%d")

set(content "// Generated by cmake/version.cmake. Do not edit.
#pragma once
#define ION_VERSION_STRING \"${ION_VERSION}\"
#define ION_GIT_COMMIT \"${commit}\"
#define ION_GIT_DIRTY ${dirty}
#define ION_BUILD_DATE \"${date}\"
")

if(EXISTS ${ION_OUTPUT})
  file(READ ${ION_OUTPUT} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE ${ION_OUTPUT} "${content}")
endif()
